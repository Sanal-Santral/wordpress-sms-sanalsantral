# Copy to .env and fill in. Empty values can also be entered later from
# WP Admin → Sanal Santral SMS → Settings.

# Sanal Santral SMS gateway credentials (username + API key / token).
SS_SMS_USERNAME=
SS_SMS_API_KEY=
# Sender header (SMS başlığı). Leave empty to pick it after "Sync senders";
# with a single header on the account it is selected automatically.
SS_SMS_SENDER=
SS_SMS_ENDPOINT=https://sms.sanalsantral.com.tr:9588

# Mobile number of the demo customer: order, shipping and login SMS go here.
DEMO_PHONE=

# Login for both demo sites.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
CUSTOMER_PASSWORD=musteri123
